+/* Sending MIDI to hardware: rawmidi rather than the sequencer.
+ *
+ * The ALSA sequencer delivers a userspace SysEx to a rawmidi port in 32-byte
+ * chunks (dump_var_event), so a 66-byte message arrives at the USB MIDI
+ * packetiser as 32 + 32 + 2. That packetiser emits whole 3-byte
+ * SysEx-continuation packets only, so after the first 64 bytes it emits 21
+ * packets -- 63 bytes -- and holds one byte back until the last chunk arrives.
+ * Whether that final packet joins the same URB is a race.
+ *
+ * Some devices do not tolerate a SysEx split across two USB transfers. A
+ * Pioneer DDJ-400 stops accepting output altogether and needs a physical power
+ * cycle. Windows delivers a midiOutLongMsg SysEx to the device as one transfer,
+ * and so do native Linux MIDI applications, because they write rawmidi.
+ *
+ * Destinations with no card behind them (other applications, Midi Through) keep
+ * the sequencer path, so application-to-application MIDI is unchanged.
+ */
+
+/* Length of a complete MIDI message from its status byte. */
+static int alsa_midi_msg_len(BYTE status)
+{
+    if (status < 0x80) return 0;
+    if (status < 0xF0)
+        return ((status & 0xF0) == 0xC0 || (status & 0xF0) == 0xD0) ? 2 : 3;
+    switch (status)
+    {
+    case 0xF1: case 0xF3: return 2;
+    case 0xF2:            return 3;
+    default:              return 1;   /* F6, F8-FF; F0/F7 go through long data */
+    }
+}
+
+/* Write a whole message, and report whether every byte was accepted. */
+static BOOL alsa_rawmidi_write(struct midi_dest *dest, const BYTE *data, UINT len)
+{
+    const BYTE *p = data;
+    UINT left = len;
+    int retries = 0;
+
+    while (left)
+    {
+        ssize_t n = snd_rawmidi_write(dest->rawmidi, p, left);
+
+        if (n == -EAGAIN)
+        {
+            /* The device is not draining. Give it a bounded chance rather than
+             * blocking a caller that may be on the application's audio thread. */
+            if (++retries > 200) break;
+            usleep(1000);
+            continue;
+        }
+        if (n < 0)
+        {
+            WARN("rawmidi write failed: %s\n", snd_strerror(n));
+            return FALSE;
+        }
+        p += n;
+        left -= n;
+    }
+
+    if (left)
+    {
+        WARN("rawmidi short write: %u of %u bytes accepted\n", len - left, len);
+        return FALSE;
+    }
+    snd_rawmidi_drain(dest->rawmidi);
+    return TRUE;
+}
+
+/* Open the hardware node behind a sequencer destination, if it has one.
+ * snd-seq-midi creates one sequencer port per rawmidi device on a card and the
+ * port number is the device number, so hw:<card>,<port> is the same endpoint. */
+static void alsa_rawmidi_open(struct midi_dest *dest, WORD dev_id)
+{
+    snd_seq_client_info_t *cinfo;
+    char name[32];
+    int card, err;
+
+    dest->rawmidi = NULL;
+
+    snd_seq_client_info_alloca(&cinfo);
+    if (snd_seq_get_any_client_info(dest->seq, dest->addr.client, cinfo) < 0) return;
+    card = snd_seq_client_info_get_card(cinfo);
+    if (card < 0) return;   /* not backed by a card: keep the sequencer path */
+
+    snprintf(name, sizeof(name), "hw:%d,%d", card, dest->addr.port);
+    err = snd_rawmidi_open(NULL, &dest->rawmidi, name, SND_RAWMIDI_NONBLOCK);
+    if (err < 0)
+    {
+        /* Busy is the expected failure when something else holds the port. */
+        dest->rawmidi = NULL;
+        WARN("cannot open %s (%s), using the sequencer\n", name, snd_strerror(err));
+        return;
+    }
+    TRACE("device %u sending directly to %s\n", dev_id, name);
+}
