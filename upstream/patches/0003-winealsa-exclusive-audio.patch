+    char raw_name[64];
 
-    params->result = alsa_open_device(params->device, params->flow, &pcm_handle, &hw_params);
+    /* The mix format is supposed to DESCRIBE THE ENDPOINT, so query the device
+     * rather than the plug layer wrapped around it. Asking plughw yields the
+     * formats ALSA could synthesise, not the ones the hardware runs at -- which
+     * is why the max_channels > 6 heuristic below exists at all: plughw reports
+     * an effectively unbounded channel count for every device, so every device
+     * collapsed to the 2-channel fallback.
+     *
+     * Measured on a Pioneer DDJ-400 (hardware: S16_LE/S24_3LE, 4 channels,
+     * 44100 Hz only): Wine advertised 48000 Hz, 2 ch, 32-bit float. rekordbox
+     * 7.2.17 takes its probe set from the mix format, so it asked for
+     * 2ch/48000/float exclusive -- three parameters the device cannot do -- and
+     * presented an empty sample-rate list. */
+    params->result = alsa_open_device(alsa_raw_device_name(params->device, raw_name, sizeof(raw_name)),
+                                      params->flow, &pcm_handle, &hw_params);
     if(FAILED(params->result))
