+            TRACE("RBW-RAWFMT build: exclusive-mode formats validated against the raw device.\n");
+        device = alsa_raw_device_name(params->device, raw_name, sizeof(raw_name));
+    }else
+        device = params->device;
 
-    params->result = alsa_open_device(params->device, params->flow, &pcm_handle, &hw_params);
+    params->result = alsa_open_device(device, params->flow, &pcm_handle, &hw_params);
     if(FAILED(params->result))
