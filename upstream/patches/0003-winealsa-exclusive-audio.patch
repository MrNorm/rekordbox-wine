+    {
+        static unsigned int rbw_calls;
+        if((rbw_calls++ % 200000) == 0)
+            TRACE("RBW-PAD call %u: padding(held)=%u bufsize=%u period=%u in_alsa=%u started=%d event=%p\n",
+                rbw_calls, stream->held_frames, stream->bufsize_frames,
