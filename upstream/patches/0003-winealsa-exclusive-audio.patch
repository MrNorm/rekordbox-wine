         max_copy_frames -= written;
     }
 
-    if(stream->event)
+    /* RBW-EVENT: only signal when the client can actually do something about
+     * it. The event means "a buffer is ready"; signalling once per period
+     * regardless leaves a client that trusts that contract calling GetBuffer for
+     * a full period and being refused with AUDCLNT_E_BUFFER_TOO_LARGE. In shared
+     * mode the buffer is several periods deep so this is almost always true and
+     * nothing changes; it matters in exclusive mode, where buffer == period. */
+    /* RBW-EVENT2: patch 0003 gated this on a full period being free. That
+     * removed the GetBuffer refusals it was written for (343 -> 0), but on a
+     * real workload it starves the client: with the condition rarely true the
+     * event fires rarely, the client writes rarely, and ALSA drains. Measured
+     * on a DDJ-400 -- the PCM cycles RUNNING -> XRUN -> closed -> XRUN
+     * continuously, even while idle, and rekordbox rebuilds the stream each
+     * time (which re-sends the LED init, hence a controller LED flashing in
+     * step with the loop).
+     *
+     * Signal whenever ANY space is free rather than a whole period. A client
+     * that asks for more than is available still gets BUFFER_TOO_LARGE and can
+     * retry, which is survivable; being left unsignalled is not. */
+    /* RBW-EVENT3: signal only when a full period is free.
+     *
+     * 0003 gated on this, 0009 relaxed it to "any space free" because the
+     * client was being starved. The starvation was really patch 0002 leaving
+     * the mmdevapi buffer one period long (fixed properly in 0010), and the
+     * relaxed gate then signalled on every timer tick whether or not the client
+     * could do anything with it. Measured cost: wineserver at 46.6% CPU and a
+     * visibly laggy UI, because every NtSetEvent is a server round-trip.
+     *
+     * With 0010 in place the buffer is several periods deep, so this condition
+     * is true often enough to keep the client fed and rare enough not to melt
+     * the server. */
+    if(stream->event &&
+       stream->bufsize_frames - stream->held_frames >= stream->mmdev_period_frames)
         NtSetEvent(stream->event, NULL);
 }
 
@@ -1844,6 +1928,40 @@
