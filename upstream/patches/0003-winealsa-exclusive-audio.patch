+/* Exclusive mode means there is no conversion layer between the application and
+ * the hardware, so the only honest answer to "is this format supported" is the
+ * hardware's own capability mask.
+ *
+ * Wine names its devices "plughw:CARD,DEV" (see the enumeration below). The plug
+ * plugin resamples, converts sample formats and remaps channels, so querying it
+ * reports what ALSA could SYNTHESISE rather than what the device can actually
+ * do. Asking it about an exclusive-mode format therefore returns S_OK for
+ * essentially anything, and the application only discovers the truth when
+ * snd_pcm_hw_params() refuses the combination at stream-creation time.
+ *
+ * Measured on a Pioneer DDJ-400, whose entire playback capability per
+ * /proc/asound/cardN/stream0 is S16_LE or S24_3LE, 4 channels, 44100 Hz:
+ * IsFormatSupported(EXCLUSIVE) accepted all 48 probed combinations, including
+ * 2-channel 192000 Hz float. rekordbox 7.2.17 believed it, called
+ * Initialize(EXCLUSIVE) at 2ch/48000/float, got
+ * AUDCLNT_E_ENDPOINT_CREATE_FAILED out of alsa_create_stream, and presented an
+ * empty sample-rate list.
+ *
+ * Shared mode is unaffected: there the plug layer really is in the path, and
+ * its converted view is the correct one to report. */
+static const char *alsa_raw_device_name(const char *alsa_name, char *buf, size_t len)
+{
+    unsigned int card, device;
+
+    if(sscanf(alsa_name, "plughw:%u,%u", &card, &device) == 2){
+        snprintf(buf, len, "hw:%u,%u", card, device);
+        return buf;
+    }
+
+    /* "default", or a name we do not recognise: nothing safe to strip. */
+    return alsa_name;
+}
