+    static int rbw_announced;
+    if (!rbw_announced++) TRACE("RBW-EVENT3 build: event gated on a free period, with a multi-period buffer.\n");
     unsigned int rate, alsa_period_us, i;
     WAVEFORMATEXTENSIBLE *fmtex = (WAVEFORMATEXTENSIBLE *)params->fmt;
     int err;
