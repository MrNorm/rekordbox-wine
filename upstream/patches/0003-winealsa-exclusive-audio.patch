         !snd_pcm_format_mask_test(formats, format)){
+        WARN("RBW-DIAG device %s: format %d (%u bit) not in mask\n",
+             debugstr_a(device), format, params->fmt_in->wBitsPerSample);
         params->result = AUDCLNT_E_UNSUPPORTED_FORMAT;
