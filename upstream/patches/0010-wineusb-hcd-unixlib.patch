wineusb.sys: enumerate USB host controllers and devices from sysfs

The PE half of the \\.\HCDn work (upstream/patches/rbw-usbhcd.c, spliced into
wineusb.c by bin/build-wineusb-hcd.sh) needs a unix-side enumeration to answer
the USB hub IOCTLs with real data. This is that half: it reads the kernel's own
view of the bus out of /sys/bus/usb/devices, so the descriptors an application
reads back are the device's actual descriptors rather than a fabrication.

Both halves must be built and installed together: unixlib.c gains a unixlib
entry point that the spliced wineusb.c is the only caller of.

Marker: RBW-USBHCD.

--- a/dlls/wineusb.sys/unixlib.c
+++ b/dlls/wineusb.sys/unixlib.c
@@ -27,6 +27,11 @@
 #include <stdlib.h>
 #include <libusb.h>
 #include <pthread.h>
+/* RBW-USBHCD: for reading the kernel's own USB descriptors out of sysfs. */
+#include <dirent.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
 #include "ntstatus.h"
 #include "windef.h"
 #include "winternl.h"
@@ -642,6 +647,101 @@
     return STATUS_SUCCESS;
 }
 
+/* RBW-USBHCD ------------------------------------------------------------- */
+
+/* Read a small sysfs attribute of a USB device. Returns bytes read, or -1. */
+static int rbw_read_attr(const char *dev, const char *attr, char *buf, size_t size)
+{
+    char path[512];
+    int fd, ret;
+
+    snprintf(path, sizeof(path), "/sys/bus/usb/devices/%s/%s", dev, attr);
+    if ((fd = open(path, O_RDONLY)) < 0)
+        return -1;
+    ret = read(fd, buf, size - 1);
+    close(fd);
+    if (ret < 0) return -1;
+    buf[ret] = 0;
+    return ret;
+}
+
+static int rbw_compare_devices(const void *a, const void *b)
+{
+    const struct usb_hcd_device *x = a, *y = b;
+    if (x->busnum != y->busnum) return (int)x->busnum - (int)y->busnum;
+    return (int)x->devnum - (int)y->devnum;
+}
+
+/* Enumerate the USB devices the kernel can see, with their real descriptors.
+ *
+ * The descriptors come byte for byte from the kernel's own
+ * /sys/bus/usb/devices/<dev>/descriptors, which holds the device descriptor
+ * followed by its configuration descriptors -- exactly what the Windows IOCTLs
+ * hand back. Nothing here is synthesised: an application asking what is plugged
+ * in gets what the hardware actually reported to Linux.
+ *
+ * Entries containing ':' are interfaces rather than devices, and entries
+ * beginning "usb" are the root hubs themselves; both are skipped, because the
+ * caller is enumerating what is plugged INTO a controller.
+ */
+static NTSTATUS usb_enum_hcd(void *args)
+{
+    struct usb_enum_hcd_params *params = args;
+    UINT32 count = 0;
+    struct dirent *ent;
+    DIR *dir;
+
+    params->count = 0;
+    if (!(dir = opendir("/sys/bus/usb/devices")))
+    {
+        WARN("RBW-USBHCD: cannot open /sys/bus/usb/devices\n");
+        return STATUS_NOT_SUPPORTED;
+    }
+
+    while ((ent = readdir(dir)) && count < params->capacity)
+    {
+        struct usb_hcd_device *dev = &params->devices[count];
+        char buf[1024];
+        int len;
+
+        if (ent->d_name[0] == '.') continue;
+        if (strchr(ent->d_name, ':')) continue;                 /* an interface */
+        if (!strncmp(ent->d_name, "usb", 3)) continue;          /* a root hub */
+
+        memset(dev, 0, sizeof(*dev));
+
+        if (rbw_read_attr(ent->d_name, "busnum", buf, sizeof(buf)) <= 0) continue;
+        dev->busnum = atoi(buf);
+        if (rbw_read_attr(ent->d_name, "devnum", buf, sizeof(buf)) <= 0) continue;
+        dev->devnum = atoi(buf);
+
+        if ((len = rbw_read_attr(ent->d_name, "descriptors", buf, sizeof(buf))) < 18)
+            continue;
+        memcpy(dev->device_desc, buf, 18);
+
+        /* Whatever follows the 18-byte device descriptor is the configuration
+         * descriptor blob, which is what a descriptor request asks for. */
+        if (len > 18)
+        {
+            dev->config_len = (UINT16)min((size_t)(len - 18), sizeof(dev->config_desc));
+            memcpy(dev->config_desc, buf + 18, dev->config_len);
+        }
+
+        dev->is_hub = (dev->device_desc[4] == 9);               /* bDeviceClass */
+        if (rbw_read_attr(ent->d_name, "speed", buf, sizeof(buf)) > 0)
+            dev->low_speed = !strncmp(buf, "1.5", 3);
+
+        count++;
+    }
+    closedir(dir);
+
+    /* Stable order, so a device keeps the same port number between calls. */
+    qsort(params->devices, count, sizeof(*params->devices), rbw_compare_devices);
+    params->count = count;
+    TRACE("RBW-USBHCD: enumerated %u USB devices\n", count);
+    return STATUS_SUCCESS;
+}
+
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
 #define X(name) [unix_ ## name] = name
@@ -651,4 +751,5 @@
     X(usb_submit_urb),
     X(usb_cancel_transfer),
     X(usb_destroy_device),
+    X(usb_enum_hcd),
 };
--- a/dlls/wineusb.sys/unixlib.h
+++ b/dlls/wineusb.sys/unixlib.h
@@ -74,6 +74,35 @@
     struct unix_device *device;
 };
 
+/* RBW-USBHCD: data for the user-mode USB host controller interface.
+ *
+ * Windows exposes every USB host controller as \\.\HCDn and lets user-mode walk
+ * the bus through it. That is what usbview.exe does, and applications use the
+ * same route to read a device's bcdDevice. Wine has no such device object at
+ * all, so an application that enumerates USB that way finds nothing.
+ *
+ * The descriptors below are copied verbatim out of the kernel's own
+ * /sys/bus/usb/devices/<dev>/descriptors, so what is reported is exactly what
+ * the hardware told Linux. Nothing here is invented or guessed.
+ */
+struct usb_hcd_device
+{
+    UINT8 busnum;
+    UINT8 devnum;
+    UINT8 is_hub;
+    UINT8 low_speed;
+    UINT8 device_desc[18];      /* raw USB device descriptor, as the kernel has it */
+    UINT16 config_len;
+    UINT8 config_desc[512];     /* raw configuration descriptor blob */
+};
+
+struct usb_enum_hcd_params
+{
+    struct usb_hcd_device *devices;
+    UINT32 capacity;            /* in: how many fit */
+    UINT32 count;               /* out: how many were filled */
+};
+
 enum unix_funcs
 {
     unix_usb_main_loop,
@@ -82,6 +111,7 @@
     unix_usb_submit_urb,
     unix_usb_cancel_transfer,
     unix_usb_destroy_device,
+    unix_usb_enum_hcd,
 };
 
 #endif
