#!/usr/bin/env bash
# Launch rekordbox for the harness, on the same Wine runtime bin/rekordbox-wine
# uses, with no launcher checks in the way.
#
# Until 2026-10-17 this copied artifacts/dxgi-patched-native-11.15.dll into the
# prefix and forced dxgi=n on every harness run, long after the system Wine had
# moved past 11.15 -- one of the ways rb7 drifted (T17, T19). The fixes are now
# builtins of the runtime, so nothing is copied and nothing is overridden.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export WINEPREFIX="${WINEPREFIX:-$ROOT/prefixes/rb7}"
# Never hardcode the version: rekordbox updates itself, and a pinned path means
# the harness silently keeps launching an old build -- or stops working at all.
# Highest version wins, which is what the shipped launcher does too.
APP="$(find "$WINEPREFIX/drive_c/Program Files/rekordbox" -maxdepth 2 -name 'rekordbox.exe' 2>/dev/null | sort -V | tail -1)"
[ -n "$APP" ] || { echo "bin/rekordbox: no rekordbox.exe under $WINEPREFIX" >&2; exit 2; }

RUNTIME="${RBW_RUNTIME:-}"
for rt in "$RUNTIME" /usr/lib/rekordbox-wine/wine "$ROOT/build/runtime/usr/lib/rekordbox-wine/wine"; do
  [ -n "$rt" ] && [ -x "$rt/bin/wine" ] && { RUNTIME="$rt"; break; }
done
if [ ! -x "${RUNTIME:-/nonexistent}/bin/wine" ]; then
  echo "bin/rekordbox: no Wine runtime — install the package or run bin/build-wine-runtime.sh build/runtime" >&2
  exit 2
fi
export WINEDLLOVERRIDES="winemenubuilder.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
exec env WINESERVER="$RUNTIME/bin/wineserver" PATH="$RUNTIME/bin:$PATH" "$RUNTIME/bin/wine" "$APP" "$@"
