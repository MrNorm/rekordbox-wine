#!/usr/bin/env bash
#
# rekordbox-wine — run-and-play launcher for rekordbox 7.2.x under Wine.
#
# One command. It checks that every piece of the configuration is in place,
# fixes what it can without asking, tells you exactly what needs root and why,
# and then starts rekordbox.
#
# The design rule here is that EVERY step must be verifiable after the fact.
# This configuration has silently reverted on us more than once — a launcher
# that forgot an override, a prefix update that restored a stock DLL, a udev
# rule that parsed fine and did nothing. In each case the application simply
# behaved as though unpatched, which looks exactly like a brand-new bug. So the
# checks below are measurements, not assumptions, and `--check` runs them all
# and prints a report without launching anything.
#
# Usage:
#   rekordbox-wine              configure if needed, then launch
#   rekordbox-wine --check      report the state of every step, launch nothing
#   rekordbox-wine --setup      configure only (use once after install)
#
# Exit codes: 0 ok · 1 misconfigured and could not self-repair · 2 bad usage
set -uo pipefail

SELF="$(basename "$0")"
PREFIX_DEFAULT="${XDG_DATA_HOME:-$HOME/.local/share}/rekordbox-wine/prefix"
# The package's own menu item runs us with no RBW_PREFIX. When rekordbox lives
# in another prefix, that item launched an empty default prefix and did nothing
# visible (2026-10-08, from the menu: "rekordbox.exe not found"). So remember
# the prefix rekordbox last started from, and use it when the default prefix
# has no rekordbox. A user of the default prefix is never affected.
PREFIX_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rekordbox-wine/prefix"
if [[ -z "${RBW_PREFIX:-}" && ! -d "$PREFIX_DEFAULT/drive_c/Program Files/rekordbox" && -r "$PREFIX_FILE" ]]; then
  _remembered="$(head -1 "$PREFIX_FILE")"
  [[ -d "$_remembered/drive_c/Program Files/rekordbox" ]] && RBW_PREFIX="$_remembered"
fi
export WINEPREFIX="${RBW_PREFIX:-$PREFIX_DEFAULT}"
# Where the package puts its helpers.
DATADIR="${RBW_DATADIR:-/usr/share/rekordbox-wine}"
[[ -d "$DATADIR" ]] || DATADIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# THE WINE RUNTIME. rekordbox runs on a complete, pinned Wine that ships inside
# this package, with every fix compiled in, at /usr/lib/rekordbox-wine/wine.
# The distro's Wine is never used, so a system update that moves it cannot
# break rekordbox. Before 2026-10-17 the launcher patched the SYSTEM Wine
# through a private symlink tree, and every Wine upgrade broke rekordbox until
# the components were rebuilt (THEMES/T14, T15). See THEMES/T19.
#
# RBW_RUNTIME overrides it; a source checkout falls back to the runtime that
# bin/build-wine-runtime.sh staged under build/runtime.
RUNTIME="${RBW_RUNTIME:-}"
if [[ -z "$RUNTIME" ]]; then
  for _rt in /usr/lib/rekordbox-wine/wine "$DATADIR/build/runtime/usr/lib/rekordbox-wine/wine"; do
    [[ -x "$_rt/bin/wine" ]] && { RUNTIME="$_rt"; break; }
  done
  RUNTIME="${RUNTIME:-/usr/lib/rekordbox-wine/wine}"
fi
WINE="$RUNTIME/bin/wine"
RT_LIB="$RUNTIME/lib/wine"
# Everything this script starts -- rbclean.sh's `wineserver -k` included --
# must reach THIS Wine. A system wineserver speaks a different protocol the
# moment the distro moves Wine on.
export WINESERVER="$RUNTIME/bin/wineserver" WINELOADER="$WINE"
export PATH="$RUNTIME/bin:$PATH"
# No Wine-generated menu entries. winemenubuilder wrote "rekordbox 7" entries
# that launched the system Wine (unpatched: one frame, then a freeze), and on
# 2026-10-08 a probe run's winemenubuilder DELETED the user's working entry
# (THEMES/T18). The package installs the one menu entry it needs.
export WINEDLLOVERRIDES="winemenubuilder.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"

# Locates the installer downloader, wherever this is running from.
rbw_fetcher() {
  local c
  for c in "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/fetch-rekordbox.sh" \
           "$DATADIR/bin/fetch-rekordbox.sh" \
           /usr/share/rekordbox-wine/bin/fetch-rekordbox.sh; do
    [[ -x "$c" ]] && { echo "$c"; return 0; }
  done
  return 1
}

# A menu launch has no terminal, so everything below -- every check, and Wine's
# own crash reports, which print even under WINEDEBUG=-all -- used to go
# nowhere. On 2026-10-08 the process hosting winebus/wineusb crashed in a menu
# launch (sc query: exit 1067) and the evidence could not be recovered. See T17.
#
# LAUNCHES only, one file each, newest five kept. The first version rotated a
# single launch.log on ANY terminal-less run: two `--check`s from a script then
# pushed a running session's log out of existence while rekordbox was still
# writing to it -- destroying exactly the evidence it was added to keep.
case "${1:-}" in
  --check|--fetch|--setup|--install) ;;
  *)
    if [[ ! -t 1 ]]; then
      _logdir="${XDG_STATE_HOME:-$HOME/.local/state}/rekordbox-wine"
      if mkdir -p "$_logdir" 2>/dev/null; then
        _log="$_logdir/launch-$(date +%Y-%m-%dT%H:%M:%S).log"
        exec >"$_log" 2>&1
        ln -sfn "$(basename "$_log")" "$_logdir/launch.log"
        ls -1t "$_logdir"/launch-*.log 2>/dev/null | tail -n +6 | xargs -r rm -f
        echo "rekordbox-wine launch $(date -Is) args: $*"
      fi
    fi ;;
esac

MODE=launch
INSTALLER=
case "${1:-}" in
  --check) MODE=check ;;
  --fetch) MODE=fetch ;;
  --setup) MODE=setup ;;
  --install)
    # Three forms:
    #   --install <file>     use that installer
    #   --install            choose a version, then install
    #   --install --latest   newest, no questions (also what happens with no tty)
    MODE=install
    INSTALLER="${2:-}"
    FETCH_ARGS=()
    case "$INSTALLER" in
      "")
        # `shift 2` on a one-element list fails, and under set -u that is fatal.
        MODE=install-fetch; shift ;;
      --latest|-y|--yes|--non-interactive)
        MODE=install-fetch; FETCH_ARGS+=(--latest); shift 2 ;;
      *)
        [[ -f "$INSTALLER" ]] || { echo "$SELF: no such file: $INSTALLER" >&2; exit 2; }
        INSTALLER="$(cd "$(dirname "$INSTALLER")" && pwd)/$(basename "$INSTALLER")"
        shift 2 || shift ;;
    esac
    ;;
  "")      ;;
  *) echo "usage: $SELF [--check|--setup|--fetch|--install [installer.exe|--latest]]" >&2; exit 2 ;;
esac

# --fetch downloads and stops. It touches no prefix and needs no Wine, so it
# runs before every check below rather than after them.
if [[ "${1:-}" == "--fetch" ]]; then
  _f="$(rbw_fetcher)" || { echo "$SELF: fetch-rekordbox.sh not found" >&2; exit 1; }
  exec "$_f" -o "${2:-$PWD}"
fi

FAIL=0
BLOCKERS=()
ok()   { printf '  \033[32mok\033[0m    %s\n' "$*"; }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$*"; }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; FAIL=1; }
note() { printf '        %s\n' "$*"; }
hdr()  { printf '\n\033[1m%s\033[0m\n' "$*"; }

# blocker() is bad() for a condition that makes LAUNCHING POINTLESS.
#
# This distinction is not cosmetic. Until 2026-09-02 every failure was advisory:
# bad() set FAIL=1, only --check and --setup ever returned it, and the launch
# path exec'd rekordbox regardless. So when wine-staging went 11.15 -> 11.16 and
# every patched binary on the machine became unloadable, the launcher printed
# three correct red FAIL lines naming the exact problem -- and then started an
# application that could not render, with no GL and unloadable native
# overrides. What the user saw was "it stopped opening", with the diagnosis
# already on screen and scrolled past. See docs/investigation/THEMES/T14.
#
# A checker that knows the run is doomed and starts it anyway is worse than no
# checker, because it converts a legible error into a mystery.
blocker() { bad "$*"; BLOCKERS+=("$*"); }
# The menu entry runs us with Terminal=false, so every FAIL and every "Not
# launching" was printed to nowhere: from the desktop, a refusal looked exactly
# like rekordbox silently not opening. Say it where the user is looking.
desktop_tell() {   # summary, body
  [[ -t 1 ]] && return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a rekordbox-wine -u critical -i dialog-error "$1" "$2" 2>/dev/null || true
}

# Registry reads parse the prefix's user.reg DIRECTLY rather than shelling out
# to `wine reg query`.
#
# This is not a style preference. `wine reg query` BOOTS the prefix: it starts a
# wineserver, services.exe, explorer.exe and the rest, purely as a side effect of
# reporting state. So `--check`, whose entire promise is "report and launch
# nothing", was starting a full Wine session; and because the default prefix
# below does not exist until first use, running --check on a fresh machine
# created and winebooted a second, empty prefix and then reported that rekordbox
# was missing from it. Reading the file has neither effect.
#
# Format, for anyone maintaining this:  [Software\\Wine\\DllOverrides] <ts>
#                                       "dxgi"="native"
# Section names are backslash-escaped in the file; keys are quoted.
reg_get() { # reg_get <section-with-single-backslashes> <key>
  local f="$WINEPREFIX/user.reg"
  [[ -r "$f" ]] || return 1
  # The section is passed through the ENVIRONMENT, not through `awk -v`, because
  # awk expands escape sequences in a -v assignment: the doubled backslashes
  # that .reg section headers actually contain arrive at the script as single
  # ones and then match nothing. Measured — every override read back as "unset"
  # on a correctly configured prefix, which is the worst possible failure for a
  # checker: it reports healthy configuration as broken.
  RBW_SECT="[${1//\\/\\\\}]" RBW_KEY="\"$2\"=" awk '
    BEGIN { sect = ENVIRON["RBW_SECT"]; key = ENVIRON["RBW_KEY"] }
    /^\[/ { inside = (index($0, sect) == 1) }
    inside && index($0, key) == 1 {
      v = substr($0, length(key) + 1); gsub(/^"|"$/, "", v); print v; exit
    }' "$f" | tr -d '\r'
}
reg_set() { # reg_set <section> <key> <value> — only ever called outside --check
  WINEDEBUG=-all "$WINE" reg add "HKCU\\$1" /v "$2" /d "$3" /f >/dev/null 2>&1
}
reg_del() { # reg_del <section> <key>
  WINEDEBUG=-all "$WINE" reg delete "HKCU\\$1" /v "$2" /f >/dev/null 2>&1
}

# ---------------------------------------------------------------- prerequisites
hdr "Prerequisites"

if [[ ! -x "$WINE" ]]; then
  bad "no Wine runtime at $RUNTIME"
  note "It ships inside the rekordbox-wine package; reinstall the package."
  desktop_tell "rekordbox was not started" "Its Wine runtime is missing from $RUNTIME. Reinstall the rekordbox-wine package."
  exit 1
fi
WINE_VER="$(sed -n 's/^wine=//p' "$RUNTIME/.rbw-runtime" 2>/dev/null)"
WINE_VER="${WINE_VER:-$("$WINE" --version 2>/dev/null | sed 's/^wine-//;s/ .*//')}"
ok "wine $WINE_VER, the package's own runtime ($RUNTIME) — the system Wine is not used"

if [[ ! -d "$WINEPREFIX" ]]; then
  if [[ $MODE == check ]]; then
    bad "no prefix at $WINEPREFIX"
  else
    warn "creating prefix at $WINEPREFIX (first run, takes a minute)"
    mkdir -p "$WINEPREFIX"
    WINEDEBUG=-all "$WINE" wineboot -u >/dev/null 2>&1
    ok "prefix created"
  fi
else
  ok "prefix $WINEPREFIX"
fi

# ----------------------------------------------------------------- the fixes
# Every fix is compiled into the runtime, so this is a measurement of the
# shipped files, not a repair. A file without its marker means a runtime built
# without the series, which loads fine and behaves as though nothing was fixed:
# the failure mode this project has paid for most often.
hdr "Fixes in the Wine runtime"
check_runtime_file() {   # path under lib/wine, marker, what breaks without it
  local path="$RT_LIB/$1" marker="$2" cost="$3"
  local name; name="$(basename "$1")"
  if [[ ! -f "$path" ]]; then
    blocker "$name missing from the Wine runtime — $cost"
  elif [[ "$(strings -a "$path" | grep -c -- "$marker" || true)" -gt 0 ]]; then
    ok "$name ($marker)"
  else
    blocker "$name in the Wine runtime is stock — $cost"
  fi
}
check_runtime_file x86_64-windows/dxgi.dll RBW-PATCH \
  "IDXGIOutput::WaitForVBlank is missing, so the window paints one frame and freezes (T01)"
check_runtime_file x86_64-windows/mmdevapi.dll RBW-MMDEV \
  "no event-driven exclusive-mode audio, so the sample-rate list is empty (T03)"
check_runtime_file x86_64-windows/setupapi.dll PhysicalDeviceObjectName \
  "volumes cannot be matched to drive letters, so a USB stick is never found (T02)"
check_runtime_file x86_64-unix/winealsa.so RBW-EVENT3 \
  "exclusive streams are refused on roughly every other period, and the DDJ-400 cannot authenticate (T03, T05)"
check_runtime_file x86_64-unix/winex11.so RBW-POPUP \
  "the File menu and the view-mode selector never appear, so EXPORT mode is unreachable (T04)"
check_runtime_file x86_64-unix/mountmgr.so RBW-REMOVABLE \
  "a USB stick never reports DRIVE_REMOVABLE (T02)"
check_runtime_file x86_64-windows/mountmgr.sys RBW-VOLNODE \
  "SetupAPI enumerates no volumes and the USB export panel stays empty (T02)"
check_runtime_file x86_64-windows/wineusb.sys RBW-USBHCD \
  "rekordbox cannot open \\\\.\\HCDn, so it rejects the controller and never opens its MIDI port (T05)"
check_runtime_file x86_64-unix/wineusb.so RBW-USBHCD \
  "the HCD driver's unix half is missing and the PE half is its only caller (T05)"

# THE ONE THING THE DISTRO CAN STILL TAKE AWAY: the system libraries the
# runtime loads. A soname bump (libgnutls.so.30 -> .31) would remove HTTPS, or
# GL, from a working install with no error until the feature is used. The same
# checker runs from a pacman hook after every transaction, so this normally
# shows up at update time rather than here.
_rtc=""
for _c in "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/rbw-runtime-check" "$DATADIR/bin/rbw-runtime-check"; do
  [[ -x "$_c" ]] && { _rtc="$_c"; break; }
done
if [[ -z "$_rtc" ]]; then
  warn "rbw-runtime-check not installed; cannot check the runtime's system libraries"
elif _out="$("$_rtc" "$RUNTIME")"; then
  ok "every system library the runtime needs is present"
else
  while IFS= read -r _l; do [[ -n "$_l" ]] && blocker "$_l"; done <<<"$_out"
fi

# ------------------------------------------------------------ prefix overrides
# Packages before 2026-10-17 put patched PE copies of dxgi, mmdevapi and
# setupapi into the prefix's system32 and forced them `native`; cfgmgr32 and
# winmm were forced native in August and never cleaned up. Those copies were
# built for ONE Wine version. With the fixes now in the runtime's builtins, a
# leftover native override pins the prefix to a stale binary -- the T14 failure,
# and the "prefix drift" that rb7 was carrying (two 11.15 DLLs on 11.18, T17).
# The launcher owns these five overrides: it removes them, and puts the
# runtime's own builtin back in system32.
hdr "Prefix DLL overrides"
_stale=0
for dll in dxgi mmdevapi setupapi cfgmgr32 winmm; do
  ov="$(reg_get 'Software\Wine\DllOverrides' "$dll")"
  [[ -n "$ov" ]] || continue
  _stale=1
  if [[ $MODE == check ]]; then
    bad "$dll is forced to '$ov' — a copy left by an older package; the runtime's builtin carries the fix"
    note "'$SELF --setup' removes it"
    continue
  fi
  reg_del 'Software\Wine\DllOverrides' "$dll"
  dst="$WINEPREFIX/drive_c/windows/system32/$dll.dll"
  if [[ -f "$dst" ]] && ! grep -qa 'Wine builtin DLL' "$dst" && [[ -f "$RT_LIB/x86_64-windows/$dll.dll" ]]; then
    cp -f "$RT_LIB/x86_64-windows/$dll.dll" "$dst.new" && mv -f "$dst.new" "$dst"
  fi
  warn "$dll: removed the stale '$ov' override; the runtime's patched builtin is used"
done
[[ $_stale -eq 0 ]] && ok "no stale native overrides — every fixed DLL comes from the runtime"

# SERVICES WHOSE PROGRAM IS MISSING. Wine 11.17 added lsass.exe and the SamSs
# service that runs it. Updating an OLDER prefix registers the service but
# does not place the program -- measured on rb7 and on a copy of it updated
# with a clean `wineboot -u`; a fresh prefix gets it. Without it every LSA call
# fails ("Failed to start SamSs service", "Failed to get security packages
# list") until rekordbox exits. Restore only programs a registered service
# points at: other Wine programs belong elsewhere in a fresh prefix, so a
# blanket copy into system32 would be wrong. See THEMES/T20.
if [[ -r "$WINEPREFIX/system.reg" ]]; then
  _missing="$(python3 - "$WINEPREFIX" <<'PYEOF'
import os, re, sys
p = sys.argv[1]
s = open(p + "/system.reg", encoding="utf-8", errors="replace").read()
names = set(re.findall(r'"ImagePath"=str\(2\):"C:\\\\windows\\\\system32\\\\([^"\\ ]+\.exe)', s, re.I))
for n in sorted(names):
    if not os.path.exists(os.path.join(p, "drive_c/windows/system32", n)):
        print(n)
PYEOF
)"
  if [[ -z "$_missing" ]]; then
    ok "every registered Windows service has its program"
  else
    for _exe in $_missing; do
      _src="$RT_LIB/x86_64-windows/$_exe"
      if [[ ! -f "$_src" ]]; then
        warn "service program $_exe is missing from the prefix and not in the runtime either"
      elif [[ $MODE == check ]]; then
        bad "service program $_exe is missing from the prefix (Wine's prefix update does not add it)"
        note "'$SELF --setup' restores it from the runtime"
      else
        cp -f "$_src" "$WINEPREFIX/drive_c/windows/system32/$_exe"
        [[ -d "$WINEPREFIX/drive_c/windows/syswow64" && -f "$RT_LIB/i386-windows/$_exe" && ! -e "$WINEPREFIX/drive_c/windows/syswow64/$_exe" ]] \
          && cp -f "$RT_LIB/i386-windows/$_exe" "$WINEPREFIX/drive_c/windows/syswow64/$_exe"
        warn "restored service program $_exe from the runtime (Wine's prefix update leaves it out)"
      fi
    done
  fi
fi

# ------------------------------------------------------------------ audio path
hdr "Audio"

# Wine's default driver order puts winepulse first, and winepulse implements no
# exclusive mode at all. rekordbox builds its sample-rate list by probing
# IsFormatSupported in EXCLUSIVE mode, so on pulse every probe on every device
# fails and the list is empty for everything.
drv="$(reg_get 'Software\Wine\Drivers' Audio)"
if [[ "$drv" != alsa ]]; then
  if [[ $MODE == check ]]; then
    bad "audio driver is '${drv:-default (pulse first)}', not alsa"
  else
    reg_set 'Software\Wine\Drivers' Audio alsa
    warn "audio driver set to alsa"
  fi
else
  ok "audio driver = alsa (winepulse has no exclusive mode; the rate list stays empty on it)"
fi

# THE DESKTOP'S OWN AUDIO. rekordbox opens ALSA `hw:` devices directly, which is
# what exclusive mode means. If PipeWire tries to start a node on the same card
# while that is happening, its open returns EBUSY, the node goes to `error`, and
# WirePlumber's error handler then throws a Lua exception on its own error
# message (alsa.lua:425 concatenates a nil node.name) — so the node is never
# retried and the DEVICE DISAPPEARS from the desktop until wireplumber is
# restarted. Measured on this machine 2026-08-17: every sink on the system gone
# for hours, reproduced Wine-free in 30 s by research/probes/pwclash.sh. See docs/investigation/THEMES/T09.
#
# A user who has just finished a set should not have to know any of that, so:
# detect the state and repair it. Restarting wireplumber is harmless — it
# recreates the nodes and takes about a second.
if command -v pactl >/dev/null 2>&1; then
  sinks=$(pactl list short sinks 2>/dev/null | grep -vc auto_null)
  if [[ "${sinks:-0}" -eq 0 ]]; then
    if [[ $MODE == check ]]; then
      bad "PipeWire has no real audio sinks — the desktop has lost its devices"
      note "repair: systemctl --user restart wireplumber   (see docs/investigation/THEMES/T09)"
    else
      warn "PipeWire has no real audio sinks — restarting wireplumber"
      systemctl --user restart wireplumber 2>/dev/null && sleep 2
      sinks=$(pactl list short sinks 2>/dev/null | grep -vc auto_null)
      if [[ "${sinks:-0}" -gt 0 ]]; then
        ok "audio devices restored ($sinks sink(s))"
      else
        bad "still no sinks after restarting wireplumber — investigate before playing"
      fi
    fi
  else
    ok "PipeWire has $sinks real sink(s)"
  fi
fi

# --------------------------------------------------------- desktop entries
# When rekordbox's installer runs, Wine writes Start Menu entries of its own
# into ~/.local/share/applications/wine/Programs/rekordbox/. They are named
# "rekordbox 7" -- which is what a user will look for -- and they launch the
# SYSTEM wine directly:
#
#     Exec=env "WINEPREFIX=..." wine "C:\\...\\rekordbox 7.lnk"
#
# That bypasses the patched Wine runtime entirely, so
# it starts an unpatched rekordbox: one frame, then a freeze. The user sees two
# entries in their menu, the obvious one is broken, and the software looks like
# it does not work.
#
# Rather than tell people not to click it, point it at us. Rewritten entries are
# marked so this is idempotent and so an entry we did not create is never
# touched.
fix_desktop_entries() {
  local dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications/wine/Programs/rekordbox"
  [[ -d "$dir" ]] || { ok "no Wine-generated menu entries to correct"; return; }
  local found=0 fixed=0 f
  while IFS= read -r -d '' f; do
    # Test an explicit marker, NOT the Exec line. The Exec line embeds the
    # prefix path, and the DEFAULT prefix is ~/.local/share/rekordbox-wine/prefix
    # -- so matching '.*rekordbox-wine' matches the PATH and every entry looks
    # already-rewritten. Measured: the repair silently did nothing on a machine
    # whose prefix sat under a directory of that name, which is the default.
    grep -q '^X-RBW-Rewritten=1' "$f" 2>/dev/null && continue
    grep -qi 'uninstall' "$f" && continue                              # leave the uninstaller alone
    found=$((found+1))
    if [[ $MODE == check ]]; then continue; fi
    # Keep the original once, so the change is reversible -- every system-level
    # change in this project records how to undo it, and a menu entry is no
    # exception. Restore with:  mv X.desktop.rbw-original X.desktop
    [[ -f "$f.rbw-original" ]] || cp -a "$f" "$f.rbw-original"
    local tmp; tmp="$(mktemp)"
    # Strip any previous rewrite of ours before writing a new one: without this
    # the note accumulates a copy per run. Path= is dropped because it pointed
    # at the prefix the ORIGINAL entry used, and a stale directory there can
    # stop the entry launching at all -- our launcher chooses its own prefix.
    # PRESERVE THE PREFIX. The original Exec carries WINEPREFIX=..., and that is
    # often NOT the default one -- a second install, a test prefix, or simply an
    # older layout. Rewriting to a bare `rekordbox-wine` throws it away, and the
    # launcher then falls back to ~/.local/share/rekordbox-wine/prefix, which may
    # hold no rekordbox at all. That turns a WORKING menu entry into one that
    # opens nothing, which is exactly what happened on the development machine.
    local orig_prefix
    orig_prefix="$(sed -n 's|^Exec=.*WINEPREFIX=\"\?\([^\"]*\)\"\?[[:space:]].*|\1|p' "$f" | head -1)"
    local exec_line='Exec=rekordbox-wine'
    [[ -n "$orig_prefix" ]] && exec_line="Exec=env RBW_PREFIX=\"$orig_prefix\" rekordbox-wine"

    sed -e "s|^Exec=.*|$exec_line|" \
        -e 's|^Name=.*|Name=rekordbox 7 (via rekordbox-wine)|' \
        -e '/^Path=/d' -e '/^X-RBW-Rewritten=/d' \
        -e '/^# Rewritten by rekordbox-wine/,+2d' "$f" \
      | sed -e '/^$/d' > "$tmp"
    {
      printf 'X-RBW-Rewritten=1\n'
      printf '\n# Rewritten by rekordbox-wine. The original launched the system Wine\n'
      printf '# directly, which starts an UNPATCHED rekordbox: one frame, then a\n'
      printf '# freeze. See THEMES/T13-coexistence.md.\n'
    } >> "$tmp"
    cat "$tmp" > "$f" && rm -f "$tmp" && fixed=$((fixed+1))
  done < <(find "$dir" -name '*.desktop' -print0 2>/dev/null)

  if [[ $found -eq 0 ]]; then
    ok "Wine's menu entries already point at rekordbox-wine"
  elif [[ $MODE == check ]]; then
    warn "$found Wine-generated menu entr(ies) launch the system Wine directly"
    note "Clicking one starts an UNPATCHED rekordbox: one frame, then a freeze."
    note "Run '$SELF --setup' to point them at this launcher."
  else
    warn "corrected $fixed Wine-generated menu entr(ies) to launch via $SELF"
  fi
}
hdr "Desktop menu entries"
fix_desktop_entries

# ------------------------------------------------------------------- rtkit
# Not required for the shipping 512-sample configuration, but a system without
# it carries a live trap: xdg-desktop-portal then advertises no realtime budget,
# libpipewire-module-rt (loaded inside THIS process via the ALSA plugin) sets
# RLIMIT_RTTIME to {0,0} -- soft and hard, irreversibly -- and any thread that
# later lands on a real-time policy is killed by SIGXCPU with no error at all.
if [[ -r /proc/self/limits ]]; then
  if systemctl is-active rtkit-daemon >/dev/null 2>&1; then
    ok "rtkit-daemon running — real-time scheduling is available and survivable"
  else
    warn "rtkit-daemon is not running — no audio thread can obtain real-time priority"
    note "Not fatal at the shipped 512-sample buffer, but RLIMIT_RTTIME is then"
    note "forced to zero inside this process and any real-time policy applied to"
    note "one of its threads kills it silently. See docs/investigation/THEMES/T12."
    note "Install with:  sudo pacman -S rtkit && sudo systemctl enable --now rtkit-daemon"
  fi
fi

# ------------------------------------------------------------------ ntsync
# THE SINGLE BIGGEST PERFORMANCE FACTOR. Without /dev/ntsync every Windows
# synchronisation primitive becomes a wineserver round-trip. rekordbox spins on
# WaitForSingleObject ~6,400 times a second, so the server burned 43-65% of a
# CPU and the UI was visibly laggy. With ntsync the same waits are handled in
# the kernel and wineserver drops to ~2%.
#
# wineserver opens /dev/ntsync ONCE at startup and caches the result
# (server/inproc_sync.c: `static int fd = -2`). Loading the module while
# wineserver is already running does nothing -- it must be restarted.
hdr "Kernel sync (ntsync)"
if [[ -e /dev/ntsync ]]; then
  ok "/dev/ntsync present — sync primitives handled in-kernel"
  if [[ -e /etc/modules-load.d/rekordbox-wine.conf ]]; then
    ok "loads automatically at boot"
  else
    warn "not configured to load at boot"
    note "echo ntsync | sudo tee /etc/modules-load.d/rekordbox-wine.conf"
  fi
else
  bad "/dev/ntsync ABSENT — expect heavy wineserver CPU and a laggy UI"
  note "sudo modprobe ntsync"
  note "then kill wineserver: it caches the device fd at startup and never retries"
fi

# ------------------------------------------------------------------- controller
hdr "Controller"

# snd_seq_dummy's "Midi Through" loopback enumerates ahead of real hardware and
# rekordbox binds to it, so no MIDI ever reaches the controller.
if lsmod 2>/dev/null | grep -q '^snd_seq_dummy'; then
  warn "snd_seq_dummy is loaded — its 'Midi Through' loopback shadows the controller"
  note "sudo modprobe -r snd_seq_dummy"
  note "permanent: echo 'blacklist snd_seq_dummy' | sudo tee /etc/modprobe.d/rekordbox-wine.conf"
else
  ok "snd_seq_dummy not loaded"
fi

# The udev rule MUST sort below 73-seat-late.rules, which is what consumes the
# uaccess tag. Numbered 99- it parses cleanly, applies nothing, and the device
# stays root-only — a failure with no error message anywhere.
if [[ -e /etc/udev/rules.d/60-pioneer-ddj.rules ]]; then
  ok "udev rule installed (must sort below 73-seat-late.rules, which consumes uaccess)"
else
  warn "no /etc/udev/rules.d/60-pioneer-ddj.rules — Wine cannot see the controller's HID interface"
  note "sudo install -m644 $DATADIR/packaging/60-pioneer-ddj.rules /etc/udev/rules.d/"
  note "then replug the controller"
fi

if lsusb 2>/dev/null | grep -qi '2b73:'; then
  hid="$(ls /dev/hidraw* 2>/dev/null | head -1)"
  if [[ -n "$hid" ]] && [[ -r "$hid" ]]; then
    ok "Pioneer device present and its HID node is readable"
  else
    warn "Pioneer device present but no readable /dev/hidraw* — replug it"
  fi

  # rekordbox finds the controller through its MIDI port, and Wine enumerates
  # MIDI through the ALSA SEQUENCER, not rawmidi. The sequencer port is created
  # by snd_seq_midi, which the kernel loads on demand when the controller is
  # plugged in. On 2026-10-07 it could not: the kernel had been upgraded without
  # a reboot, Arch had deleted the running kernel's modules, and the replugged
  # DDJ-400 got a rawmidi device and no sequencer port. Every check here said ok;
  # rekordbox said "no controller". See THEMES/T16.
  if [[ -r /proc/asound/seq/clients ]] && ! grep -qiE '^Client +[0-9]+ : "(DDJ|Pioneer)' /proc/asound/seq/clients; then
    if [[ ! -d "/lib/modules/$(uname -r)" ]]; then
      bad "the controller has no MIDI port: kernel $(uname -r) is running but its modules were removed by an upgrade"
      note "Reboot. The kernel was updated and cannot load snd_seq_midi until you do."
      desktop_tell "DDJ controller will not be detected" \
        "The kernel was updated and the computer has not been restarted since, so the controller's MIDI driver cannot load. Restart, then start rekordbox again."
    else
      bad "the controller has no ALSA sequencer port, so rekordbox cannot see it"
      note "sudo modprobe snd_seq_midi   then replug the controller"
      desktop_tell "DDJ controller will not be detected" \
        "Its MIDI port is missing. Run: sudo modprobe snd_seq_midi, then replug the controller."
    fi
  else
    ok "controller has an ALSA sequencer port (how Wine finds its MIDI)"
  fi
else
  note "no Pioneer device connected (fine if you are not using one)"
fi

# --------------------------------------------------------------- session state
# A prefix left holding processes from a previous run is not untidy, it is slow.
# Measured 2026-08-14: 36 orphaned Wine processes, 3.1 GB resident, 650 CPU-
# seconds burned, and three duplicate rekordbox icons in the system tray. Worse,
# wineserver opens /dev/ntsync ONCE and caches the fd for life, so a session
# inherited from before the module was loaded runs every sync primitive through
# a server round-trip -- 43-65% wineserver CPU against 1.5-1.9% with ntsync.
# That is the difference the user reported as the UI becoming laggy over time.
hdr "Session state"
if [[ -x "$DATADIR/bin/rbclean.sh" ]]; then
  if RBW_PREFIX="$WINEPREFIX" "$DATADIR/bin/rbclean.sh" --check >/dev/null 2>&1; then
    ok "prefix is clean — no processes left from a previous run"
  elif [[ $MODE == check ]]; then
    warn "the prefix still holds processes from a previous session"
    note "they cost RAM and CPU, they put duplicate icons in your system tray,"
    note "and a wineserver older than /dev/ntsync never picks ntsync up."
    note "clear them with: $DATADIR/bin/rbclean.sh"
  else
    warn "clearing processes left over from a previous session"
    RBW_PREFIX="$WINEPREFIX" "$DATADIR/bin/rbclean.sh" --quiet \
      || bad "could not clear the previous session — see $DATADIR/bin/rbclean.sh"
  fi
else
  warn "bin/rbclean.sh not installed — cannot verify the prefix is idle"
fi

# --------------------------------------------------------------- audio settings
# THE PC MASTER OUT FIX. docs/investigation/THEMES/T10 phases 34-42.
#
# rekordbox will not produce ANY audio until every output device has completed
# three seconds' worth of callbacks, and it then keeps each device's queue three
# buffers deep and tears BOTH streams down after 100 close-spaced corrections.
# Two of its own settings decide whether that machinery is stable under Wine:
#
#   WasapiPolling = 0  the writer sizes each block from GetBufferSize(), which
#                      under Wine is four periods for the exclusive controller
#                      stream and one for the shared PC endpoint. The two
#                      devices then run at 43 and 172 callbacks a second, the
#                      queues diverge, and the engine restarts its whole audio
#                      subsystem every 15.9 s -- playback runs at 0.05x with a
#                      1.2 s dropout four times a minute. Measured, repeatedly.
#   WasapiPolling = 1  the writer uses the device PERIOD instead, both devices
#                      run at the same rate, and playback is 1.00x.
#
#   AudioBufferSize    at 256 frames a residual teardown still arrives about
#                      once every three minutes, because Wine gives no rekordbox
#                      thread real-time priority and the scheduling jitter is a
#                      large fraction of a 5.8 ms block. At 512 (11.6 ms):
#                      465 s of continuous play, ZERO teardowns. 512 is
#                      therefore the floor this launcher enforces; a user who
#                      has chosen something larger is left alone.
#
# The file is rewritten by rekordbox every ~15 s while it runs, so this must
# happen with the application stopped -- which the session-state step above has
# just guaranteed.
hdr "Audio settings"
SETTINGS="$(ls "$WINEPREFIX"/drive_c/users/*/AppData/Roaming/Pioneer/rekordbox6/rekordbox3.settings 2>/dev/null | head -1)"
if [[ -z "$SETTINGS" ]]; then
  # rekordbox writes this file itself on first run -- but it MERGES an existing
  # one, keeping values it finds and filling in the rest with its defaults
  # (measured: a two-key seed came back with 97 keys, both seeded values
  # intact). So seed it now rather than telling the user to start the
  # application, quit, and start it again before PC MASTER OUT works. That
  # instruction was the last manual step, and the kind of thing a new user does
  # not do -- they would try PC MASTER OUT in their first session, hit the
  # stall, and conclude the software is broken.
  SEED_DIR="$(ls -d "$WINEPREFIX"/drive_c/users/*/AppData/Roaming 2>/dev/null | head -1)"
  if [[ -n "$SEED_DIR" && $MODE != check ]]; then
    SEED_DIR="$SEED_DIR/Pioneer/rekordbox6"
    mkdir -p "$SEED_DIR"
    cat > "$SEED_DIR/rekordbox3.settings" <<'SEEDEOF'
<?xml version="1.0" encoding="UTF-8"?>

<PROPERTIES>
  <VALUE name="WasapiPolling" val="1"/>
  <VALUE name="AudioBufferSize" val="512"/>
</PROPERTIES>
SEEDEOF
    ok "seeded the PC MASTER OUT audio settings — correct from the first launch"
  elif [[ -n "$SEED_DIR" ]]; then
    warn "no rekordbox3.settings yet — '$SELF --setup' will seed the PC MASTER OUT fix"
  else
    note "no prefix user directory yet — install rekordbox first with '$SELF --install'"
  fi
else
  RBW_SETTINGS="$SETTINGS" RBW_MODE="$MODE" python3 - <<'PYEOF'
import os, re, sys
path = os.environ["RBW_SETTINGS"]; check = os.environ["RBW_MODE"] == "check"
d = open(path, "rb").read()
def get(key):
    m = re.search(('name="%s" val="([^"]*)"' % key).encode(), d)
    return m.group(1).decode() if m else None
def put(data, key, val):
    return re.sub(('(name="%s" val=")[^"]*(")' % key).encode(),
                  lambda m: m.group(1) + val.encode() + m.group(2), data, count=1)
changed = []
pol = get("WasapiPolling")
if pol is None:
    print("        WasapiPolling is not in the settings file — cannot set it")
elif pol != "1":
    if check: print("  \033[33mwarn\033[0m  WasapiPolling is %s, not 1 — PC MASTER OUT will stall at 0.05x" % pol)
    else:
        d = put(d, "WasapiPolling", "1"); changed.append("WasapiPolling %s -> 1" % pol)
else:
    print("  \033[32mok\033[0m    WasapiPolling = 1")
buf = get("AudioBufferSize")
if buf is None:
    print("        AudioBufferSize is not in the settings file")
elif not buf.isdigit() or int(buf) < 512:
    if check: print("  \033[33mwarn\033[0m  AudioBufferSize is %s — below 512 a teardown arrives every ~3 min" % buf)
    else:
        d = put(d, "AudioBufferSize", "512"); changed.append("AudioBufferSize %s -> 512" % buf)
else:
    print("  \033[32mok\033[0m    AudioBufferSize = %s (>= 512)" % buf)
if changed:
    open(path + ".rbw-backup", "wb").write(open(path, "rb").read())
    open(path, "wb").write(d)
    for c in changed:
        print("  \033[32mok\033[0m    %s   (previous file kept as rekordbox3.settings.rbw-backup)" % c)
PYEOF
fi

# ---------------------------------------------------------------- known issues
if [[ $MODE == check ]]; then
  hdr "Known unresolved issues"
  cat <<'EOF'
  · No exported USB stick has ever been read by a real CDJ. The export itself
    works and bin/pdbcheck.py validates the database outside Wine, but that is
    a gate, not a finish line. See docs/investigation/THEMES/T02.
  · The DDJ-400 has never been through a full performance pass — every pad
    mode, the FX section, filters, crossfader curve, headphone cue, hot cues.
    Jog wheels and LEDs are confirmed. See docs/investigation/THEMES/T05.
  · Latency is 512 samples (11.6 ms), which is what a DDJ-400 user runs on
    Windows too. Lower costs about one stream teardown every 330 s, because
    AvSetMmThreadCharacteristics is still a stub in Wine and no audio thread
    gets real-time priority. See docs/investigation/THEMES/T10.
  · Frame rate is healthy and measured: 58 fps with a track loaded, zero
    dropped frames. With both decks empty rekordbox runs its own 33 ms frame
    limiter and idles at 30 fps — that is the application's design, not a
    fault. Re-measure with research/probes/fpsmatrix.sh if it ever feels wrong.
EOF
  [[ $FAIL -eq 0 ]] && printf '\n\033[32mAll configured steps verified.\033[0m\n' \
                    || printf '\n\033[31mSome steps failed — see FAIL lines above.\033[0m\n'
  exit $FAIL
fi

[[ $MODE == setup ]] && { echo; echo "Setup complete. Run '$SELF --check' to verify."; exit $FAIL; }

# --------------------------------------------------------------------- install
# Everything above has already prepared the prefix -- the patched builtins, the
# overrides and the audio settings -- so by here the installer is running into a
# configured prefix rather than a bare one. That ordering matters: rekordbox's
# installer starts the application at the end, and an unprepared prefix means
# the first thing a new user sees is the one-frame freeze this project exists to
# fix.
if [[ $MODE == install-fetch ]]; then
  hdr "Choosing a rekordbox version"
  _f="$(rbw_fetcher)" || { bad "fetch-rekordbox.sh not found"; exit 1; }
  _dl="${RBW_DOWNLOAD_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/rekordbox-wine}"
  mkdir -p "$_dl"
  # The chosen installer is read back off the filesystem rather than parsed out
  # of the downloader's output, so changing its wording cannot silently yield an
  # empty path. The marker file names the choice, because "newest on disk" is
  # wrong the moment someone picks an older version deliberately.
  _pick="$_dl/.chosen"; rm -f "$_pick"
  RBW_PICK_FILE="$_pick" "$_f" -o "$_dl" "${FETCH_ARGS[@]}" || { bad "could not obtain an installer"; exit 1; }
  INSTALLER="$(cat "$_pick" 2>/dev/null || true)"
  [[ -f "${INSTALLER:-}" ]] || \
    INSTALLER="$(find "$_dl" -maxdepth 1 -name 'Install_rekordbox_x64_*.exe' 2>/dev/null | sort -V | tail -1)"
  [[ -n "${INSTALLER:-}" && -f "$INSTALLER" ]] || {
    bad "no installer .exe was produced"
    note "unzip the download and pass the .exe to $SELF --install <file>"; exit 1; }
  ok "using $INSTALLER"
  MODE=install
fi

if [[ $MODE == install ]]; then
  hdr "Installing rekordbox"
  note "$INSTALLER"
  note "the silent installer still shows ONE language dialog — press Return"
  if "$WINE" "$INSTALLER" /S; then
    EXE="$(find "$WINEPREFIX/drive_c/Program Files/rekordbox" -maxdepth 2 -name 'rekordbox.exe' 2>/dev/null | sort -V | tail -1)"
    if [[ -n "$EXE" ]]; then
      ok "installed: $EXE"
      echo; echo "Now run '$SELF' to launch, or '$SELF --check' to verify."
      exit 0
    fi
    bad "the installer finished but no rekordbox.exe appeared under the prefix"
    exit 1
  fi
  bad "the installer exited non-zero"
  exit 1
fi

# ---------------------------------------------------------------------- launch
#
# STOP HERE IF THE RUN IS ALREADY LOST.
#
# Everything above self-repairs what it can. What reaches this point is what
# could NOT be repaired -- and for the conditions marked blocker() that means
# rekordbox will start, fail to render or fail to load its overrides, and look
# to the user like software that broke for no reason. On 2026-09-02 that is
# exactly what happened, and the diagnosis was already printed above the
# failure. Refusing here converts a mystery back into a message. See THEMES/T14.
if [[ ${#BLOCKERS[@]} -gt 0 ]]; then
  hdr "Not launching"
  note "rekordbox would start and fail. These must be fixed first:"
  for b in "${BLOCKERS[@]}"; do printf '  \033[31m·\033[0m %s\n' "$b"; done
  echo
  note "The Wine runtime ships inside the package and no system update can"
  note "change it, so a failure here means the package itself is damaged or a"
  note "system library it loads has been removed. Reinstalling the package is"
  note "the fix for both; the lines above say which."
  echo
  note "Full report:  $SELF --check"
  desktop_tell "rekordbox was not started" \
    "$(printf '%s\n' "${BLOCKERS[@]}")
Run '$SELF --check' in a terminal for the fix."
  exit 1
fi

EXE="$(find "$WINEPREFIX/drive_c/Program Files/rekordbox" -maxdepth 2 -name 'rekordbox.exe' 2>/dev/null | sort -V | tail -1)"
if [[ -z "$EXE" ]]; then
  bad "rekordbox.exe not found under $WINEPREFIX/drive_c/Program Files/rekordbox"
  note "install it with: $SELF --install <rekordbox-installer.exe>"
  desktop_tell "rekordbox is not installed in $WINEPREFIX" \
    "Install it with: $SELF --install   or start it once with RBW_PREFIX set to the prefix that has it."
  exit 1
fi
if [[ $MODE == launch ]]; then
  mkdir -p "$(dirname "$PREFIX_FILE")" 2>/dev/null && echo "$WINEPREFIX" > "$PREFIX_FILE" 2>/dev/null || true
fi

hdr "Launching"
note "$EXE"

# WHICH REKORDBOX, AND HAS IT BEEN MEASURED?
#
# No path here is ever hardcoded -- the find above takes the newest install, so
# a rekordbox self-update is picked up with nothing to do. That much has been
# true since thirteen harness scripts broke on the 7.2.17 -> 7.2.18 update.
#
# What was missing is the RECORD. Wine versions get supported-wine.txt, a build
# gate, a launch refusal and a daily CI watch; rekordbox versions got nothing,
# so "does the version you are running actually work" had no written answer.
#
# This WARNS and does not refuse, and the asymmetry is deliberate. An unlisted
# Wine is a broken install -- the components cannot load, there is nothing to
# try. An unlisted rekordbox is merely unmeasured: our fixes are Wine-side
# implementations of APIs rekordbox calls, and a point release does not
# invalidate them. Refusing would stop someone DJing over a paperwork gap.
# The reasoning is written out in full in upstream/supported-rekordbox.txt.
RB_VER="$(basename "$(dirname "$EXE")" | sed 's/^rekordbox //')"
# Look in DATADIR first, which is where the package puts its own data and is
# the one path this script already knows is right. The source-tree location
# comes next, and the doc directory is DERIVED from DATADIR rather than
# hardcoded to /usr/share/doc -- the same mistake as the winepaths.sh one, where
# a hardcoded /usr/lib/wine worked on Arch and silently did nothing elsewhere.
RB_SUPPORTED=""
for _rs in "$DATADIR/supported-rekordbox.txt" \
           "$DATADIR/upstream/supported-rekordbox.txt" \
           "$(dirname "$DATADIR")/doc/rekordbox-wine/supported-rekordbox.txt"; do
  [[ -r "$_rs" ]] && { RB_SUPPORTED="$_rs"; break; }
done
if [[ -n "$RB_VER" && -n "$RB_SUPPORTED" ]]; then
  if grep -qE "^[[:space:]]*${RB_VER//./\.}([[:space:]]|$)" "$RB_SUPPORTED"; then
    ok "rekordbox $RB_VER — measured; see docs/GOLD-STATUS.md"
  else
    warn "rekordbox $RB_VER has not been measured by this project"
    note "Known: $(grep -vE '^[[:space:]]*(#|$)' "$RB_SUPPORTED" | awk '{print $1}' | paste -sd, | sed 's/,/, /g')"
    note "Starting anyway — the fixes are Wine-side and a rekordbox update does"
    note "not invalidate them. If everything works, say so: adding $RB_VER to"
    note "upstream/supported-rekordbox.txt is a one-line contribution."
  fi
fi
exec env WINEDEBUG="${WINEDEBUG:--all}" "$WINE" "$EXE" "$@"
