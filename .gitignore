# built by research/probes/fpsmatrix.sh from damagefps.c
bin/damagefps

# per-run evidence from bin/rbtest.sh
runs/RBTEST/

# makepkg's working directories and output, left in packaging/ by `makepkg -si`.
# makepkg also REWRITES pkgver= in the PKGBUILD from pkgver(), so a build in a
# checkout dirties a tracked file; `git checkout packaging/PKGBUILD` undoes it.
packaging/src/
packaging/pkg/
packaging/rekordbox-wine/
packaging/*.pkg.tar.zst
packaging/*.pkg.tar.zst.sig

# Screenshots used by the README. *.png above exists to keep run evidence out of
# the repository; these are hand-checked crops with no library, account or
# filesystem detail in them.
!docs/images/*.png
