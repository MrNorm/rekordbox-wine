# rekordbox 7.2.17 — PRIMARY TARGET.
# The version actually wanted. Needs no Wine-hiding shim: rekordbox 7 dropped
# the detection path that broke 5.x/6.x (WineHQ 42497). Only line that writes
# both legacy Device Library and OneLibrary to one stick (7.2.11+).
# Two Garbage AppDB reports exist (7.2.8 on main, 7.2.14 on 11.8) — both on
# Nvidia/AMD. No published result on an Intel iGPU at any version, ever.
RB_VERSION=7.2.17
# CORRECTED 2026-09-02: this said the download page is JS-driven and the
# installer had to be supplied by hand. It is not. The page lists the x64
# installer URL in its HTML; bin/fetch-rekordbox.sh scrapes it, and
# `rekordbox-wine --install` with no argument downloads and installs.
# Inner payload: Install_rekordbox_x64_7_2_17.exe, 659536536 bytes, dated 2026-07-07.
RB_INSTALLER_FILE="Install_rekordbox_x64_7_2_17.zip"
RB_INSTALLER_SHA256="518fb7d11d0484715420f410d29eb7b406d7c18cfee7bf68fb613321c8b8b181"
RB_INSTALLER_URL=""
WINE_BIN=wine
WIN_VERSION=win11
WINETRICKS_VERBS="corefonts"
HIDE_WINE_EXPORTS=0
WINE_DRIVER=x11
