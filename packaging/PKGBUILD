# Maintainer: see upstream repository
#
# THE PRIMARY PKGBUILD. It builds straight from the GitHub repository, because
# this project is deliberately not on the AUR -- AUR pushes have been blocked
# over malware injection, and a package whose whole argument is "audit the
# chain" should not ask you to trust that chain.
#
#   git clone https://github.com/MrNorm/rekordbox-wine.git
#   cd rekordbox-wine/packaging && makepkg -si
#
# PKGBUILD.release beside this one builds from a tagged release tarball and is
# what an AUR submission would use, if that ever becomes appropriate.
#
# rekordbox-wine — the Wine patches and configuration that rekordbox 7.2.x needs
# on Linux, plus a launcher that verifies every one of them before starting.
#
# WHAT THIS PACKAGE IS NOT: it does not contain rekordbox. rekordbox is
# proprietary and must be downloaded from rekordbox.com by the user, and signed
# in to with their own AlphaTheta account. This package ships its own patched Wine,
# a udev rule, a modprobe rule, a pacman hook, and the launcher.
#
# STATE, HONESTLY — see GOLD-STATUS.md in the source tree for the evidence
# behind every line of this:
#
#   WORKS, measured: the main window renders and repaints (nothing else gets
#   past this — stock Wine paints one frame and freezes); library, waveforms and
#   two-deck playback at 1.00x; Preferences; the File menu and the view-mode
#   selector that gates EXPORT mode; DDJ-400 exclusive-mode audio at 44100 Hz;
#   PC MASTER OUT — controller and computer speakers together — with zero stream
#   teardowns over 465 s; USB export, with the resulting export.pdb validated
#   outside Wine; the DDJ-400's jog wheels and LEDs.
#
#   NOT PROVEN: no exported stick has been read by a real CDJ. The database is
#   validated by bin/pdbcheck.py, which is a gate and not a finish line.
#
#   NOT COMPLETE: the DDJ-400 has never been through a full performance pass —
#   every pad mode, the FX section, filters, crossfader curve, headphone cue and
#   hot cues. That needs hands on the hardware.
#
#   KNOWN CEILING: AvSetMmThreadCharacteristics is a stub in Wine, so no audio
#   thread gets real-time priority. The package therefore ships a 512-sample
#   buffer (11.6 ms), which is what a DDJ-400 user runs on Windows anyway. Going
#   lower costs roughly one stream teardown every 330 s. See docs/investigation/THEMES/T10.
#
# ITS OWN WINE, AND WHY: the fixes are patches to Wine internals, which change
# with every Wine release. This package therefore ships a complete Wine (11.18
# with the wine-staging patchset, see upstream/wine-runtime.conf) with the
# patches compiled in, at /usr/lib/rekordbox-wine/wine, and runs rekordbox on
# that alone. The distro's Wine is neither used nor modified, so a system update
# that moves Wine cannot break rekordbox. Earlier versions patched the system
# Wine and broke on every Wine upgrade (THEMES/T14, T15, T19).
#
# The build compiles all of Wine, for both 64-bit and 32-bit Windows programs
# (WoW64: no lib32 packages needed). Expect 20-60 minutes depending on the CPU.

pkgname=rekordbox-wine-git
pkgver=0.3.0
pkgrel=1
pkgdesc="rekordbox 7.2.x with a DDJ-400 on Linux: a pinned, patched Wine and a launcher that verifies it"
arch=('x86_64')
url="https://github.com/MrNorm/rekordbox-wine"
license=('LGPL-2.1-or-later')  # the Wine patches; the launcher scripts are MIT

provides=('rekordbox-wine')
conflicts=('rekordbox-wine')
# What the runtime links against or dlopen()s for the capabilities rekordbox
# uses. No 'wine' or 'wine-staging': the package carries its own, and either
# can be installed beside it or not at all.
depends=('glibc' 'libgcc' 'attr' 'fontconfig' 'freetype2' 'gnutls' 'libglvnd'
         'libx11' 'libxext' 'libxrandr' 'libxi' 'libxcursor' 'libxcomposite'
         'libxinerama' 'libxrender' 'libxfixes' 'libxxf86vm' 'libxkbcommon' 'wayland'
         'alsa-lib' 'dbus' 'libusb' 'systemd-libs' 'libpcap'
         'alsa-utils' 'python')
# Wine's configure does not fail when a development package is missing: it
# drops the feature. bin/build-wine-runtime.sh refuses that for every feature
# rekordbox needs (X, GL, ALSA, USB, udev, dbus, gnutls, fonts).
makedepends=('git' 'python' 'curl' 'autoconf' 'perl' 'flex' 'bison' 'mingw-w64-gcc'
             'libx11' 'libxext' 'libxrandr' 'libxcomposite' 'libxfixes' 'libxi'
             'libxcursor' 'libxinerama' 'libxrender' 'libxxf86vm' 'libxkbcommon' 'wayland'
             'alsa-lib' 'libpulse' 'dbus' 'freetype2' 'fontconfig' 'gnutls' 'libusb'
             'systemd' 'libpcap' 'attr'
             # GL/gl.h and GL/glx.h; without them winex11.so has no GLX (issue #3).
             'libglvnd' 'mesa' 'vulkan-headers' 'vulkan-icd-loader' 'opencl-headers'
             'sdl2' 'gst-plugins-base-libs' 'ffmpeg')
optdepends=(
  'pipewire-alsa: audio routing alongside other applications'
  'rtkit: lets audio threads obtain real-time priority. Without it the desktop portal advertises no realtime budget, libpipewire-module-rt sets RLIMIT_RTTIME to zero inside every ALSA client, and any thread later put on a real-time policy is killed by SIGXCPU. See docs/investigation/THEMES/T12'
  'kernel-modules-hook: keeps the running kernel modules after a kernel upgrade until you reboot, so a controller plugged in before the reboot still works'
  'gst-plugins-base-libs: media decoding through Windows Media Foundation'
  'ffmpeg: media decoding through Windows Media Foundation'
  'vulkan-icd-loader: Vulkan, for Direct3D 12'
  'libpulse: the PulseAudio driver (rekordbox-wine selects ALSA)'
)
install=rekordbox-wine.install

# Wine cannot be built with link-time optimisation: LTO drops the symbols that
# ntdll's hand-written syscall dispatcher references from assembly, and the
# build dies with `undefined reference to init_syscall_frame`. Arch's own wine
# package disables it for the same reason. !strip and !debug keep makepkg away
# from the PE builtins, which are not ELF; build-wine-runtime.sh strips the
# unix side itself.
options=('!lto' '!strip' '!debug')

# Built straight from GitHub — no AUR involved. Cloning the canonical URL is
# what makes this reproducible: makepkg records the commit it built.
source=("rekordbox-wine::git+$url.git")
sha256sums=('SKIP')   # a git source is verified by its revision, not a hash

pkgver() {
  cd "$srcdir/rekordbox-wine"
  # 0.2.0.r<commits>.g<short-sha> — sorts correctly and names the exact commit.
  printf "%s.r%s.g%s" "0.3.0" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/rekordbox-wine"

  # Build inside $srcdir, not in ~/.cache. A developer's cache holds a Wine tree
  # that may carry whatever diagnostic code was being measured that week, so a
  # package built there would not be reproducible on anyone else's machine.
  export RBW_WINE_BUILD="$srcdir/wine-build"
  # makepkg's CFLAGS carry -flto and hardening flags meant for ordinary C;
  # Wine's own defaults are what every measurement was made with.
  unset CFLAGS CXXFLAGS LDFLAGS

  # Fetches the pinned Wine and wine-staging (sha256-checked), applies staging,
  # then the series, builds everything and verifies every marker in the
  # INSTALLED tree. Stages into build/runtime, where install-tree.sh takes it.
  ./bin/build-wine-runtime.sh build/runtime
}

check() {
  cd "$srcdir/rekordbox-wine"
  # Every patched component carries a marker; a stock one loads perfectly and
  # behaves as though nothing was ever fixed. The list lives in one place.
  packaging/verify-tree.sh build/runtime
}

package() {
  cd "$srcdir/rekordbox-wine"
  # One definition of the payload, shared with debian/rules and the rpm spec.
  packaging/install-tree.sh "$pkgdir"
}
